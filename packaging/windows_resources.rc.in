1 ICON "@ICON@"
1 VERSIONINFO
FILEVERSION @VERSION_NUMERIC@
PRODUCTVERSION @VERSION_NUMERIC@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x2L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "ModSync contributors\0"
      VALUE "FileDescription", "ModSync pre-release\0"
      VALUE "FileVersion", "@VERSION_TEXT@\0"
      VALUE "ProductName", "ModSync\0"
      VALUE "ProductVersion", "@VERSION_TEXT@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
