<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app bundle by Tauri: lets Nexus Mods "Mod Manager
     Download" (nxm://) links open this app. Same declaration as
     modsync::protocol_registration::macos_nxm_url_types_plist_fragment. -->
<plist version="1.0">
<dict>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Nexus Mods Protocol</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>nxm</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
